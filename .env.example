# === Credenciales de MIeL ===
MIEL_DNI=dni_goes_here
MIEL_PASSWORD=password_goes_here

# === URLs de MIeL ===
MIEL_LOGIN_URL=https://miel.unlam.edu.ar/principal/home/
MIEL_HOME_URL=https://miel.unlam.edu.ar/principal/interno/

# === Bot de Discord ===
# Crear una app/bot en https://discord.com/developers/applications y pegar el token en esta sección.
DISCORD_TOKEN=token_goes_here
# ID del canal o usuario (para recibir DMs) donde se enviarán los avisos.
# Activar el modo desarrollador en Discord para poder copiar IDs con click derecho.
DISCORD_CHANNEL_ID=id_goes_here

# === Comportamiento del bot ===
# Cada cuántos segundos MIeL es revisado en busca de mensajes nuevos.
POLL_INTERVAL_SECONDS=60

# Corre el navegador sin ventana visible (recomendado para dejarlo andando en segundo plano).
HEADLESS=true
